@page "{id:int}"
@model JewelryStore.Pages.Decoration.DeleteModel
@{
}

<h1>Удалить украшение</h1>

<h3>Вы уверены?</h3>

<div>
    <p><strong>@Model.TheProduct.Title</strong></p>
    <p>@Model.TheProduct.Price</p>
</div>

<form method="post">
    <input type="hidden" asp-for="TheProduct.Id" />
    <button type="submit">Удалить</button>
</form>

<a asp-page="Index">Отмена</a>
