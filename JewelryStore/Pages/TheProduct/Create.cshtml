@page
@model JewelryStore.Pages.Decoration.CreateModel
@{
}


<h1>Добавить украшение</h1>

<form method="post">
    <div>
        <label>Название</label><br />
        <input asp-for="TheProduct.Title" />
        <span asp-validation-for="TheProduct.Title"></span>
    </div>

    <div>
        <label>Цена</label><br />
        <input asp-for="TheProduct.Price" />
    </div>

    <div>
        <label>Продукт</label><br />
        <input asp-for="TheProduct.Product" type="number" />
    </div>

    <div>
        <label>Проба</label><br />
        <input asp-for="TheProduct.Test" type="number" />
    </div>

    <div>
        <label>Дата производства</label><br />
        <input asp-for="TheProduct.ProductionDate" type="number" />
    </div>

    <button type="submit">Сохранить</button>
</form>

<a asp-page="Index">Назад</a>