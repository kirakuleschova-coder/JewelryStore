@page
@model JewelryStore.Pages.Buyer.IndexModel
@{
}

<div class="container mt-4">
    <!-- Заголовок и кнопка добавления -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="bi bi-people"></i> Список покупателей
        </h2>
        <a asp-page="Create" class="btn btn-primary">
            <i class="bi bi-person-plus"></i> Добавить покупателя
        </a>
    </div>

    <!-- Сетка карточек -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var buyer in Model.Buyers)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <div class="text-center mb-3">
                            <i class="bi bi-person-circle" style="font-size: 3rem; color: #0d6efd;"></i>
                        </div>
                        <h5 class="card-title text-primary text-center">@buyer.FIO</h5>
                        <hr />
                        <p class="card-text">
                            <strong><i class="bi bi-card-text"></i> ИНН:</strong><br />
                            <span class="font-monospace">@buyer.INN</span>
                        </p>
                    </div>
                    <div class="card-footer bg-transparent border-0">
                        <div class="d-flex gap-2">
                            <a asp-page="Details" asp-route-id="@buyer.Id" class="btn btn-sm btn-info flex-fill">
                                <i class="bi bi-eye"></i> Открыть
                            </a>
                            <a asp-page="Edit" asp-route-id="@buyer.Id" class="btn btn-sm btn-primary flex-fill">
                                <i class="bi bi-pencil"></i> Изменить
                            </a>
                            <a asp-page="Delete" asp-route-id="@buyer.Id" class="btn btn-sm btn-danger flex-fill">
                                <i class="bi bi-trash"></i> Удалить
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .font-monospace {
        font-family: monospace;
        font-size: 0.9rem;
        background-color: #f8f9fa;
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        display: inline-block;
    }
</style>