@page
@model JewelryStore.Pages.Buyer.IndexModel
@{
}

<div class="container mt-four">
    <div class="row">
        <div class="col-twelve">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-zero">Список покупателей</h5>
                        <a asp-page="Create" class="btn btn-primary btn-sm">+ Добавить</a>
                    </div>
                </div>
                <div class="card-body p-zero">
                    <table class="table mb-zero">
                        <thead>
                            <tr>
                                <th>ИНН</th>
                                <th>ФИО</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var buyer in Model.Buyers)
                            {
                                <tr>
                                    <td>@buyer.INN</td>
                                    <td>@buyer.FIO</td>
                                    <td>
                                        <a asp-page="Details" asp-route-id="@buyer.Id" class="btn btn-light btn-sm">Открыть</a>
                                        <a asp-page="Edit" asp-route-id="@buyer.Id" class="btn btn-light btn-sm">Изменить</a>
                                        <a asp-page="Delete" asp-route-id="@buyer.Id" class="btn btn-light btn-sm">Удалить</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>