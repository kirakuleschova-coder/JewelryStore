@page
@model JewelryStore.Pages.Buyer.IndexModel
@{
}

<div class="container mt-4">
    <!-- Заголовок и кнопка добавления -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-0">
                <i class="bi bi-people"></i> Список покупателей
            </h2>
            <p class="text-muted mt-2">Управление данными покупателей</p>
        </div>
        <a asp-page="Create" class="btn btn-primary">
            <i class="bi bi-person-plus"></i> Добавить покупателя
        </a>
    </div>

    <!-- Счётчик покупателей -->
    <div class="alert alert-info mb-4 d-flex justify-content-between align-items-center">
        <span>
            <i class="bi bi-info-circle"></i> Всего покупателей:
            <strong>@Model.Buyers.Count()</strong>
        </span>
        <span class="badge bg-primary rounded-pill">
            <i class="bi bi-grid-3x3-gap-fill"></i> Карточки
        </span>
    </div>

    <!-- Сетка карточек -->
    @if (Model.Buyers.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var buyer in Model.Buyers)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 card-hover">
                        <div class="card-body text-center">
                            <div class="mb-3">
                                <i class="bi bi-person-circle" style="font-size: 3rem; color: #0d6efd;"></i>
                            </div>
                            <h5 class="card-title text-primary">@buyer.FIO</h5>
                            <hr />
                            <p class="card-text">
                                <strong><i class="bi bi-card-text"></i> ИНН:</strong><br />
                                <span class="font-monospace bg-light p-1 rounded">@buyer.INN</span>
                            </p>
                        </div>
                        <div class="card-footer bg-transparent border-0">
                            <div class="d-flex gap-2">
                                <a asp-page="Details" asp-route-id="@buyer.Id" class="btn btn-sm btn-info flex-fill">
                                    <i class="bi bi-eye"></i> Открыть
                                </a>
                                <a asp-page="Edit" asp-route-id="@buyer.Id" class="btn btn-sm btn-primary flex-fill">
                                    <i class="bi bi-pencil"></i> Изменить
                                </a>
                                <a asp-page="Delete" asp-route-id="@buyer.Id" class="btn btn-sm btn-danger flex-fill">
                                    <i class="bi bi-trash"></i> Удалить
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Пустое состояние -->
        <div class="text-center py-5">
            <div class="alert alert-info">
                <i class="bi bi-emoji-frown" style="font-size: 3rem;"></i>
                <h3 class="mt-3">Пока нет покупателей</h3>
                <p>Добавьте первого покупателя, нажав на кнопку выше</p>
                <a asp-page="Create" class="btn btn-primary mt-2">
                    <i class="bi bi-person-plus"></i> Добавить покупателя
                </a>
            </div>
        </div>
    }
</div>

<style>
    .card-hover {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .card-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.15) !important;
        }

    .btn {
        transition: all 0.2s ease;
    }

        .btn:hover {
            transform: translateY(-2px);
        }

    .font-monospace {
        font-family: 'Courier New', monospace;
        font-size: 0.9rem;
        display: inline-block;
        padding: 4px 8px;
    }
</style>