@page
@model JewelryStore.Pages.Buyer.IndexModel
@{
}

<div class="container mt-four">
    <div class="row">
        <div class="col-twelve">
            <div class="card">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-zero">Список покупателей</h5>
                    <a asp-page="Create" class="btn btn-light btn-sm">+ Добавить покупателя</a>
                </div>
                <div class="card-body p-zero">
                    <div class="table-responsive">
                        <table class="table table-hover mb-zero">
                            <thead class="table-light">
                                <tr>
                                    <th>ИНН</th>
                                    <th>ФИО</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var buyer in Model.Buyers)
                                {
                                    <tr>
                                        <td>@buyer.INN</td>
                                        <td>
                                            <span>@buyer.FIO</span>
                                        </td>
                                        <td>
                                            <div class="d-flex gap-two">
                                                <a asp-page="Details" asp-route-id="@buyer.Id" class="btn btn-info btn-sm">Открыть</a>
                                                <a asp-page="Edit" asp-route-id="@buyer.Id" class="btn btn-warning btn-sm">Изменить</a>
                                                <a asp-page="Delete" asp-route-id="@buyer.Id" class="btn btn-danger btn-sm">Удалить</a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>