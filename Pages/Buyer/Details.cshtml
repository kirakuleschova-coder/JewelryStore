@page "{id:int}"
@model JewelryStore.Pages.Buyer.DetailsModel
@{
}

<div class="container mt-four">
    <div class="row justify-content-center">
        <div class="col-md-six">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-zero">Информация о покупателе</h5>
                </div>
                <div class="card-body">
                    <div class="mb-three">
                        <strong>ИНН:</strong> @Model.Buyer.INN
                    </div>
                    <div class="mb-three">
                        <strong>ФИО:</strong> @Model.Buyer.FIO
                    </div>

                    <div class="d-flex gap-two">
                        <a asp-page="Index" class="btn btn-light">Назад</a>
                        <a asp-page="Edit" asp-route-id="@Model.Buyer.Id" class="btn btn-primary">Редактировать</a>
                        <a asp-page="Delete" asp-route-id="@Model.Buyer.Id" class="btn btn-danger">Удалить</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

