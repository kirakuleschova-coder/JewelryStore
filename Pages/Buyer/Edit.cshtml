@page
@model JewelryStore.Pages.Buyer.EditModel
@{
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">
                        <i class="bi bi-pencil-square"></i> Редактирование покупателя
                    </h5>
                </div>
                <div class="card-body">
                    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

                    <div class="alert alert-info border-0 small">
                        <div class="d-flex align-items-start">
                            <i class="bi bi-info-circle text-primary fs-4 me-3"></i>
                            <div>
                                <strong>Редактирование данных</strong><br />
                                Измените необходимые поля и нажмите "Сохранить"
                            </div>
                        </div>
                    </div>

                    <form method="post" id="editForm">
                        <input type="hidden" asp-for="Buyer.Id" />

                        <div class="mb-3">
                            <label asp-for="Buyer.INN" class="form-label fw-bold">
                                <i class="bi bi-card-text"></i> ИНН
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-white">
                                    <i class="bi bi-upc-scan text-primary"></i>
                                </span>
                                <input asp-for="Buyer.INN" class="form-control"
                                       placeholder="10 или 12 цифр"
                                       maxlength="12"
                                       autocomplete="off" />
                                <button class="btn btn-outline-secondary" type="button" id="clearInn">
                                    <i class="bi bi-x-circle"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Buyer.INN" class="text-danger"></span>
                            <div class="form-text" id="innHelpText">
                                <i class="bi bi-info-circle"></i> ИНН должен содержать 10 или 12 цифр
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Buyer.FIO" class="form-label fw-bold">
                                <i class="bi bi-person"></i> ФИО
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-white">
                                    <i class="bi bi-person-badge text-success"></i>
                                </span>
                                <input asp-for="Buyer.FIO" class="form-control"
                                       placeholder="Иванов Иван Иванович"
                                       autocomplete="name" />
                                <button class="btn btn-outline-secondary" type="button" id="clearFio">
                                    <i class="bi bi-x-circle"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Buyer.FIO" class="text-danger"></span>
                            <div class="form-text">
                                <i class="bi bi-info-circle"></i> Введите полное ФИО покупателя
                            </div>
                        </div>

                        <div class="alert alert-light border small">
                            <div class="d-flex align-items-start">
                                <i class="bi bi-lightbulb text-warning fs-4 me-3"></i>
                                <div>
                                    <strong>Примеры правильного заполнения:</strong><br />
                                    <span class="font-monospace">123456789012</span> - ИНН (12 цифр)<br />
                                    <span>Иванов Иван Иванович</span> - ФИО
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-secondary border-0 small">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <i class="bi bi-hash"></i> ID покупателя:
                                    <strong>@Model.Buyer.Id</strong>
                                </div>
                                <div>
                                    <i class="bi bi-clock-history"></i>
                                    <small>Редактирование записи</small>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <a asp-page="Index" class="btn btn-secondary flex-fill">
                                <i class="bi bi-arrow-left"></i> Назад
                            </a>
                            <button type="submit" class="btn btn-primary flex-fill">
                                <i class="bi bi-save"></i> Сохранить изменения
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card mt-3 bg-light border-0">
                <div class="card-body text-center text-muted">
                    <small>
                        <i class="bi bi-info-circle"></i>
                        Все поля обязательны для заполнения
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .form-control:focus {
        border-color: #ffc107;
        box-shadow: 0 0 0 0.25rem rgba(255, 193, 7, 0.25);
    }

    .btn {
        transition: all 0.2s ease;
    }

        .btn:hover {
            transform: translateY(-2px);
        }

    .card {
        transition: box-shadow 0.2s ease;
    }

        .card:hover {
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }

    .input-group-text {
        background-color: #f8f9fa;
        border-right: none;
    }

    .input-group .form-control {
        border-left: none;
        border-right: none;
    }

    .input-group .btn-outline-secondary {
        border-left: none;
    }

        .input-group .btn-outline-secondary:hover {
            background-color: #dc3545;
            border-color: #dc3545;
            color: white;
        }

    .font-monospace {
        font-family: 'Courier New', monospace;
        font-weight: 600;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const innInput = document.querySelector('input[asp-for="Buyer.INN"]');
            const fioInput = document.querySelector('input[asp-for="Buyer.FIO"]');
            const clearInnBtn = document.getElementById('clearInn');
            const clearFioBtn = document.getElementById('clearFio');

            function validateINN(inn) {
                const innStr = inn.toString();
                if (!/^\d+$/.test(innStr)) return false;
                const length = innStr.length;
                return length === 10 || length === 12;
            }

            if (innInput) {
                innInput.addEventListener('input', function(e) {
                    this.value = this.value.replace(/[^0-9]/g, '');
                });

                innInput.addEventListener('keyup', function(e) {
                    const length = this.value.length;
                    const helpText = document.getElementById('innHelpText');

                    if (helpText) {
                        if (length === 10) {
                            helpText.innerHTML = '<i class="bi bi-check-circle text-success"></i> ✓ ИНН юридического лица (10 цифр)';
                            helpText.className = 'form-text text-success fw-bold';
                        } else if (length === 12) {
                            helpText.innerHTML = '<i class="bi bi-check-circle text-success"></i> ✓ ИНН физического лица (12 цифр)';
                            helpText.className = 'form-text text-success fw-bold';
                        } else if (length > 0 && length < 10) {
                            helpText.innerHTML = '<i class="bi bi-exclamation-triangle text-warning"></i> ⚠ ИНН должен содержать 10 или 12 цифр';
                            helpText.className = 'form-text text-warning';
                        } else {
                            helpText.innerHTML = '<i class="bi bi-info-circle"></i> ИНН должен содержать 10 или 12 цифр';
                            helpText.className = 'form-text';
                        }
                    }
                });
            }

            if (clearInnBtn) {
                clearInnBtn.addEventListener('click', function() {
                    innInput.value = '';
                    innInput.focus();
                    const helpText = document.getElementById('innHelpText');
                    if (helpText) {
                        helpText.innerHTML = '<i class="bi bi-info-circle"></i> ИНН должен содержать 10 или 12 цифр';
                        helpText.className = 'form-text';
                    }
                });
            }

            if (clearFioBtn) {
                clearFioBtn.addEventListener('click', function() {
                    fioInput.value = '';
                    fioInput.focus();
                });
            }
        });
    </script>
}