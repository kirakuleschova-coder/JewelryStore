@page
@model JewelryStore.Pages.Buyer.EditModel
@{
}

<div class="container mt-four">
    <div class="row justify-content-center">
        <div class="col-md-six">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-zero">Редактирование покупателя</h5>
                </div>
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" asp-for="Buyer.Id" />

                        <div class="mb-three">
                            <label asp-for="Buyer.INN" class="form-label">ИНН</label>
                            <input asp-for="Buyer.INN" class="form-control" />
                            <span asp-validation-for="Buyer.INN" class="text-danger"></span>
                        </div>

                        <div class="mb-three">
                            <label asp-for="Buyer.FIO" class="form-label">ФИО</label>
                            <input asp-for="Buyer.FIO" class="form-control" />
                            <span asp-validation-for="Buyer.FIO" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-two">
                            <a asp-page="Index" class="btn btn-secondary">Назад</a>
                            <button type="submit" class="btn btn-success">Сохранить</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}