@page "{id:int}"
@model JewelryStore.Pages.Buyer.DeleteModel

<div class="container mt-four">
    <div class="row justify-content-center">
        <div class="col-md-six">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-zero">Подтверждение удаления</h5>
                </div>
                <div class="card-body">
                    <p class="mb-three">Вы действительно хотите удалить покупателя:</p>

                    <div class="mb-three">
                        <strong>ИНН: @Model.Buyer.INN</strong><br />
                        <span>ФИО: @Model.Buyer.FIO</span>
                    </div>

                    <form method="post">
                        <input type="hidden" asp-for="Buyer.Id" />
                        <div class="d-flex gap-two">
                            <a asp-page="Index" class="btn btn-light">Отмена</a>
                            <button type="submit" class="btn btn-danger">Удалить</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
