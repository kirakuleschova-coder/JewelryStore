@page
@model JewelryStore.Pages.Decoration.CreateModel
@{
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Добавить украшение</h4>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Название</label>
                            <input asp-for="TheProduct.Title" class="form-control" />
                            <span asp-validation-for="TheProduct.Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Цена</label>
                            <input asp-for="TheProduct.Price" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Продукт</label>
                            <input asp-for="TheProduct.Product" type="number" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Проба</label>
                            <input asp-for="TheProduct.Test" type="number" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Дата производства</label>
                            <input asp-for="TheProduct.ProductionDate" type="number" class="form-control" />
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-save"></i> Сохранить
                            </button>
                            <a asp-page="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Назад
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}