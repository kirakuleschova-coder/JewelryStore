@page "{id:int}"
@model JewelryStore.Pages.Decoration.EditModel
@{
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">
                        <i class="bi bi-pencil-square"></i> Редактировать украшение
                    </h4>
                </div>
                <div class="card-body">
                    <!-- Блок вывода общих ошибок -->
                    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

                    <form method="post">
                        <input type="hidden" asp-for="TheProduct.Id" />

                        <div class="mb-3">
                            <label asp-for="TheProduct.Title" class="form-label fw-bold">Название</label>
                            <input asp-for="TheProduct.Title" class="form-control" placeholder="Введите название украшения" />
                            <span asp-validation-for="TheProduct.Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TheProduct.Price" class="form-label fw-bold">Цена (руб.)</label>
                            <input asp-for="TheProduct.Price" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="TheProduct.Price" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TheProduct.Product" class="form-label fw-bold">Продукт</label>
                            <input asp-for="TheProduct.Product" type="number" class="form-control" placeholder="Введите номер продукта" />
                            <span asp-validation-for="TheProduct.Product" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TheProduct.Test" class="form-label fw-bold">Проба</label>
                            <input asp-for="TheProduct.Test" type="number" class="form-control" placeholder="375, 585, 750, 999" />
                            <span asp-validation-for="TheProduct.Test" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TheProduct.ProductionDate" class="form-label fw-bold">Дата изготовления (год)</label>
                            <input asp-for="TheProduct.ProductionDate" type="number" class="form-control" placeholder="ГГГГ" />
                            <span asp-validation-for="TheProduct.ProductionDate" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Сохранить
                            </button>
                            <a asp-page="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Назад
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}