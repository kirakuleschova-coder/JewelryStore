@page
@model JewelryStore.Pages.Decoration.IndexModel
@{
}

<div class="container">
    <div class="card mt-3">
        <div class="card-header">
            <h3>Список украшений</h3>
        </div>
        <div class="card-body">
            <p>
                <a asp-page="Create" class="btn btn-primary">Добавить новое украшение</a>
            </p>

            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Название</th>
                        <th>Цена</th>
                        <th>Продукт</th>
                        <th>Проба</th>
                        <th>Год изготовления</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var TheProduct in Model.TheProducts)
                    {
                        <tr>
                            <td>@TheProduct.Title</td>
                            <td>@TheProduct.Price</td>
                            <td>@TheProduct.Product</td>
                            <td>@TheProduct.Test</td>
                            <td>@TheProduct.ProductionDate</td>
                            <td>
                                <a asp-page="Details" asp-route-id="@TheProduct.Id" class="btn btn-sm btn-info">Открыть</a>
                            <td><a asp-page="Edit" asp-route-id="@TheProduct.Id" class="btn btn-sm btn-primary"><i class="bi bi-pencil"></i> Изменить</a></td>
                            <td><a asp-page="Delete" asp-route-id="@TheProduct.Id" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i> Удалить</a></td>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>