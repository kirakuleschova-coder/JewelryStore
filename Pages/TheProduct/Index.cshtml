@page
@model JewelryStore.Pages.Decoration.IndexModel
@{
}

<div class="container mt-4">
    <!-- Заголовок и кнопка добавления -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Наши украшения</h1>
        <a asp-page="Create" class="btn btn-primary btn-lg">
            <i class="bi bi-plus-circle"></i> Добавить украшение
        </a>
    </div>

    <!-- Сетка карточек -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var TheProduct in Model.TheProducts)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title text-primary">
                            <i class="bi bi-gem"></i> @TheProduct.Title
                        </h5>
                        <hr />
                        <p class="card-text">
                            <strong><i class="bi bi-tag"></i> Цена:</strong>
                            <span class="text-success fw-bold">@TheProduct.Price руб.</span><br />
                            <strong><i class="bi bi-box"></i> Продукт:</strong> @TheProduct.Product<br />
                            <strong><i class="bi bi-gem"></i> Проба:</strong> @TheProduct.Test<br />
                            <strong><i class="bi bi-calendar"></i> Год изготовления:</strong> @TheProduct.ProductionDate
                        </p>
                    </div>
                    <div class="card-footer bg-transparent">
                        <div class="d-flex gap-2">
                            <a asp-page="Details" asp-route-id="@TheProduct.Id" class="btn btn-sm btn-info flex-fill">
                                <i class="bi bi-eye"></i> Открыть
                            </a>
                            <a asp-page="Edit" asp-route-id="@TheProduct.Id" class="btn btn-sm btn-primary flex-fill">
                                <i class="bi bi-pencil"></i> Изменить
                            </a>
                            <a asp-page="Delete" asp-route-id="@TheProduct.Id" class="btn btn-sm btn-danger flex-fill">
                                <i class="bi bi-trash"></i> Удалить
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>